# ============================================================================
# ETS LE PRIVILÈGE DAOUKRO — variables de configuration
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# CE FICHIER NE CONTIENT AUCUN SECRET : ne jamais versionner le fichier .env.
# ============================================================================

# --- Serveur ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# URL publique utilisée pour les liens absolus, le sitemap et les retours paiement.
# En aperçu Arena : https://3000-<id-du-sandbox>.e2b.app
PUBLIC_URL=http://localhost:3000
# Derrière un proxy inverse (nginx, Caddy, plateforme d'hébergement)
TRUST_PROXY=1

# --- Base de données (SQLite) -----------------------------------------------
# Un seul fichier = une sauvegarde simple. Chemin relatif à la racine du projet.
DATABASE_PATH=data/boutique.sqlite
# Journalisation WAL + attente en cas de verrou (ms)
DB_BUSY_TIMEOUT_MS=5000

# --- Sécurité (À RENSEIGNER IMPÉRATIVEMENT EN PRODUCTION) -------------------
# Clé de signature des cookies de session et des jetons (64 caractères mini).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-please-generate-a-long-random-secret
# Secret de signature des notifications de paiement reçues du prestataire.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Mot de passe du premier compte administrateur créé par `npm run seed`.
# À changer immédiatement après la première connexion.
ADMIN_EMAIL=admin@leprivilege.example
ADMIN_PASSWORD=Change-Moi-2026!
ADMIN_NAME=Administrateur

# --- Protection contre les abus (limitation de débit) -----------------------
# Requêtes comptées par fenêtre et par adresse IP. Les fichiers statiques
# (/assets) et les images (/media) ne sont PAS comptés : seules les pages et les
# appels d'API le sont.
# ATTENTION en Côte d'Ivoire : les connexions mobiles passent souvent par un
# CGNAT, plusieurs clients partageant la même adresse IP publique. Si des
# visiteurs reçoivent « Trop de demandes » (429) sans raison apparente,
# augmenter RATE_LIMIT_MAX plutôt que de désactiver la protection.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
# Tentatives de connexion (administration et compte client) par fenêtre
RATE_LIMIT_AUTH_MAX=10
# Soumissions du tunnel de commande par fenêtre de 10 minutes. Plafond large à
# dessein : l'anti-doublon repose sur la clé d'idempotence, et une valeur basse
# pénaliserait des clients partageant une même IP publique (CGNAT mobile).
RATE_LIMIT_CHECKOUT_MAX=60
# Notifications de paiement reçues du prestataire par fenêtre
RATE_LIMIT_WEBHOOK_MAX=300

# --- Stockage des médias ----------------------------------------------------
MEDIA_DIR=data/media
IMPORT_DIR=data/imports
BACKUP_DIR=data/backups
# Taille maximale d'une image téléversée (octets) — 8 Mo par défaut
MAX_UPLOAD_BYTES=8388608
# Formats d'image acceptés
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif

# --- Paiement ---------------------------------------------------------------
# `true` = la passerelle de démonstration est autorisée (à désactiver en production).
PAYMENT_SIMULATION_ENABLED=true
# Chemin local de la passerelle de démonstration (mode bac à sable uniquement).
PAYMENT_SIMULATION_PATH=/paiements/simuler
# Identifiants marchands : À RENSEIGNER après souscription auprès des prestataires.
# Tant qu'ils sont vides, les moyens correspondants restent « non configurés ».
WAVE_MERCHANT_ID=
WAVE_API_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MTN_MOMO_TARGET_ENV=
MTN_MOMO_SUBSCRIPTION_KEY=
MOOV_MERCHANT_ID=
MOOV_MERCHANT_SECRET=

# --- Options métier ---------------------------------------------------------
# Durée de réservation du stock d'un panier (minutes)
CART_RESERVATION_MINUTES=15
# Durée de réservation du stock d'une commande en attente de paiement (minutes)
ORDER_RESERVATION_MINUTES=90
# Nombre d'articles par page du catalogue
CATALOG_PAGE_SIZE=24
# Consentement marketing distinct et facultatif
MARKETING_CONSENT_ENABLED=true

# --- Démonstration ----------------------------------------------------------
# Base de démonstration séparée de la base réelle (jamais utilisée en production).
DEMO_DATABASE_PATH=data/demo.sqlite
DEMO_MEDIA_DIR=data/demo-media
