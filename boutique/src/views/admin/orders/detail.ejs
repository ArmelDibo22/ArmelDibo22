<%
/**
 * Détail d'une commande : préparation, livraison, encaissement, devis,
 * retours et remboursements. Toutes les actions sont journalisées.
 */
const o = order;
const paid = ['paid', 'partially_refunded', 'refunded'].includes(o.payment_status);
const awaitingCash = o.payment_status === 'awaiting_confirmation';
const quoteOpen = Boolean(o.quote_required) && ['requested', 'sent'].includes(o.quote_status);
const paidAmount = o.amount_paid || 0;
const remaining = Math.max(0, o.total - paidAmount);
const refundable = Math.max(0, paidAmount - o.amount_refunded);
const scopeLabels = { order: 'Commande', payment: 'Paiement', delivery: 'Livraison', quote: 'Devis', note: 'Note' };
%>
<%- include('/admin/partials/header') %>

<div class="admin-head">
  <div>
    <h1><span class="mono"><%= o.reference %></span></h1>
    <p class="sub">
      <%= dates.formatDateTime(o.placed_at) %> ·
      <%= o.fulfillment_mode === 'pickup' ? 'Retrait en boutique' : `Livraison — ${o.zone ? o.zone.name : ''}` %> ·
      <%= o.items.length %> article(s) · <%= money.format(o.total) %>
    </p>
  </div>
  <div class="btn-row">
    <a class="btn btn--quiet" href="/admin/commandes"><%- icon('arrow-left', 'sm') %> Liste</a>
    <a class="btn btn--ghost" href="/admin/commandes/<%= o.id %>/impression" target="_blank" rel="noopener"><%- icon('print', 'sm') %> Imprimer</a>
    <% if (whatsappUrl) { %><a class="btn btn--whatsapp" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer"><%- icon('whatsapp', 'sm') %> WhatsApp</a><% } %>
  </div>
</div>

<!-- ---------------- Bandeau d'état ---------------- -->
<div class="panel">
  <div class="panel-body" style="display:flex;flex-wrap:wrap;gap:var(--space-4);align-items:center">
    <div>
      <span class="tiny muted" style="display:block">Commande</span>
      <span class="pill pill--<%= statusTone('order', o.status) %>"><%= labels.order[o.status] || o.status %></span>
    </div>
    <div>
      <span class="tiny muted" style="display:block">Paiement</span>
      <span class="pill pill--<%= statusTone('payment', o.payment_status) %>"><%= labels.payment[o.payment_status] || o.payment_status %></span>
    </div>
    <div>
      <span class="tiny muted" style="display:block">Livraison / retrait</span>
      <span class="pill pill--<%= statusTone('delivery', o.delivery_status) %>"><%= labels.delivery[o.delivery_status] || o.delivery_status %></span>
    </div>
    <% if (quoteOpen) { %>
      <div>
        <span class="tiny muted" style="display:block">Devis</span>
        <span class="pill pill--warn"><%= o.quote_status === 'sent' ? `Envoyé : ${money.format(o.quote_amount || 0)}` : 'À établir' %></span>
      </div>
    <% } %>
    <div style="margin-left:auto;text-align:right">
      <span class="tiny muted" style="display:block">Réglé / dû</span>
      <strong><%= money.format(paidAmount) %></strong>
      <% if (remaining > 0) { %><span class="pill pill--warn" style="margin-left:6px">reste <%= money.format(remaining) %></span><% } %>
    </div>
  </div>
  <% if (o.status === 'cancelled') { %>
    <div class="panel-foot"><strong style="color:var(--danger)">Commande annulée</strong> — <%= o.cancel_reason || 'sans motif précisé' %> <% if (o.cancelled_at) { %>(<%= dates.formatDateTime(o.cancelled_at) %>)<% } %>. Le stock réservé a été libéré.</div>
  <% } %>
</div>

<div class="split split--2">
  <!-- =============== Colonne principale =============== -->
  <div>
    <div class="panel">
      <div class="panel-head"><h2>Articles</h2><span class="hint">Prix figés au moment de la commande</span></div>
      <div class="panel-body panel-body--flush">
        <div class="scroll-x">
          <table class="data compact">
            <caption class="visually-hidden">Articles de la commande</caption>
            <thead>
              <tr><th scope="col">Article</th><th scope="col" class="num">Qté</th><th scope="col" class="num">P.U.</th><th scope="col" class="num">Total</th><th scope="col">Stock</th></tr>
            </thead>
            <tbody>
              <% stockItems.forEach(function (row) { %>
                <% const it = row.item; %>
                <tr>
                  <td>
                    <strong><%= it.name %></strong>
                    <% if (it.options_label) { %><span class="tiny muted" style="display:block"><%= it.options_label %></span><% } %>
                    <span class="tiny muted mono"><%= it.sku || 'sans réf.' %><% if (it.is_kit) { %> · kit<% } %></span>
                    <% if (row.product) { %>
                      <a class="tiny" href="/admin/produits/<%= row.product.id %>" style="display:block">Ouvrir la fiche</a>
                    <% } %>
                  </td>
                  <td class="num"><%= it.qty %></td>
                  <td class="num"><%= money.format(it.unit_price) %><% if (it.original_price !== it.unit_price) { %><span class="price-compare" style="display:block;font-size:.75rem"><%= money.format(it.original_price) %></span><% } %></td>
                  <td class="num"><strong><%= money.format(it.line_total) %></strong></td>
                  <td class="tiny">
                    <% if (row.stockItem) { %>
                      <span class="pill pill--<%= (row.stockItem.qty_on_hand - row.stockItem.qty_reserved) <= 0 ? 'danger' : 'neutral' %>">
                        <%= row.stockItem.qty_on_hand %> en stock · <%= row.stockItem.qty_reserved %> réservé(s)
                      </span>
                    <% } else if (row.product && !row.product.track_stock) { %>
                      <span class="pill pill--info">stock non suivi</span>
                    <% } else { %>
                      <span class="pill">—</span>
                    <% } %>
                  </td>
                </tr>
                <% if (it.is_kit) { %>
                  <% const kit = (kitDetails || []).find((k) => k.item.id === it.id); %>
                  <% if (kit && kit.components.length) { %>
                    <tr>
                      <td colspan="5" style="background:var(--surface)">
                        <span class="tiny muted">Composition du kit :</span>
                        <ul class="tiny" style="margin:4px 0 0;padding-left:18px">
                          <% kit.components.forEach(function (c) { %>
                            <li>
                              <%= c.product_name %> (<span class="mono"><%= c.product_sku || '—' %></span>) × <%= c.quantity * it.qty %>
                              <% if (c.track_stock) { %> — stock composant : <%= c.qty_on_hand || 0 %><% } else { %> — stock non suivi<% } %>
                            </li>
                          <% }); %>
                        </ul>
                      </td>
                    </tr>
                  <% } %>
                <% } %>
              <% }); %>
            </tbody>
            <tfoot>
              <tr><td colspan="3" class="right">Sous-total</td><td class="num"><%= money.format(o.subtotal) %></td><td></td></tr>
              <% if (o.discount > 0) { %><tr><td colspan="3" class="right">Remise</td><td class="num">− <%= money.format(o.discount) %></td><td></td></tr><% } %>
              <tr>
                <td colspan="3" class="right"><%= o.fulfillment_mode === 'pickup' ? 'Retrait en boutique' : 'Livraison' %></td>
                <td class="num"><% if (quoteOpen) { %>Sur devis<% } else { %><%= money.format(o.shipping_cost) %><% } %></td>
                <td></td>
              </tr>
              <tr><td colspan="3" class="right"><strong>Total</strong></td><td class="num"><strong class="price"><%= money.format(o.total) %></strong></td><td></td></tr>
            </tfoot>
          </table>
        </div>
      </div>
      <% if (o.customer_note) { %>
        <div class="panel-foot"><strong>Note du client :</strong> <%= o.customer_note %></div>
      <% } %>
    </div>

    <!-- ---------------- Statut de commande ---------------- -->
    <div class="panel" id="statut">
      <div class="panel-head"><h2>Faire avancer la commande</h2><span class="hint">Transitions autorisées uniquement</span></div>
      <div class="panel-body">
        <form method="post" action="/admin/commandes/<%= o.id %>/statut" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field" style="flex:1 1 220px">
            <label for="status">Nouveau statut</label>
            <select id="status" name="status">
              <% (transitions || []).forEach(function (t) { %>
                <option value="<%= t %>"><%= labels.order[t] || t %></option>
              <% }); %>
            </select>
            <% if (!transitions || !transitions.length) { %>
              <span class="field-help">Aucune transition possible depuis « <%= labels.order[o.status] || o.status %> ».</span>
            <% } %>
          </div>
          <div class="field" style="flex:2 1 260px">
            <label for="status-note">Note (facultatif, visible dans l’historique)</label>
            <input id="status-note" name="note" type="text" maxlength="300">
          </div>
          <button class="btn" type="submit" <%= transitions && transitions.length ? '' : 'disabled' %>><%- icon('check', 'sm') %> Appliquer</button>
        </form>
      </div>
    </div>

    <!-- ---------------- Livraison / retrait ---------------- -->
    <div class="panel" id="livraison">
      <div class="panel-head">
        <h2><%= o.fulfillment_mode === 'pickup' ? 'Retrait en boutique' : 'Livraison' %></h2>
        <span class="hint">Transporteur, référence et étapes</span>
      </div>
      <div class="panel-body">
        <dl class="kv" style="margin-bottom:var(--space-4)">
          <% if (o.fulfillment_mode === 'pickup') { %>
            <dt>Lieu</dt><dd><%= store.name %>, <%= store.city %><% if (store.address) { %> — <%= store.address %><% } %></dd>
            <% if (o.pickup_at) { %><dt>Disponible depuis</dt><dd><%= dates.formatDateTime(o.pickup_at) %></dd><% } %>
          <% } else { %>
            <dt>Zone</dt><dd><%= o.zone ? o.zone.name : '—' %><% if (o.zone && o.zone.eta_text) { %> · <%= o.zone.eta_text %><% } %></dd>
            <dt>Destinataire</dt><dd><%= o.recipient_name %> · <%= formatPhone(o.recipient_phone) %></dd>
            <dt>Adresse</dt><dd><%= [o.quarter, o.address, o.city].filter(Boolean).join(', ') || '—' %><% if (o.landmark) { %> <span class="tiny muted">(repère : <%= o.landmark %>)</span><% } %></dd>
            <% if (o.recipient_email) { %><dt>E-mail</dt><dd><%= o.recipient_email %></dd><% } %>
            <dt>Frais</dt><dd><% if (quoteOpen) { %>Sur devis<% } else { %><%= money.format(o.shipping_cost) %><% } %></dd>
          <% } %>
          <% if (o.desired_date) { %><dt>Date souhaitée</dt><dd><%= o.desired_date %></dd><% } %>
        </dl>

        <% if (o.fulfillment_mode === 'delivery' && can('orders.write')) { %>
          <form method="post" action="/admin/commandes/<%= o.id %>/livraison" data-delivery-form
                data-zone-carriers='<%- JSON.stringify(Object.fromEntries(zones.map((z) => [String(z.id), carriers.filter((c) => c.enabled).map((c) => c.id)]))) %>'
                class="form-grid form-grid--3" style="margin-bottom:var(--space-4)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="carrier_id">Transporteur</label>
              <select id="carrier_id" name="carrier_id">
                <option value="">— aucun —</option>
                <% carriers.forEach(function (c) { %>
                  <option value="<%= c.id %>" <%= o.carrier_id === c.id ? 'selected' : '' %>><%= c.name %><%= c.enabled ? '' : ' (désactivé)' %></option>
                <% }); %>
              </select>
            </div>
            <div class="field">
              <label for="tracking_reference">Référence de suivi</label>
              <input id="tracking_reference" name="tracking_reference" type="text" maxlength="120" value="<%= o.tracking_reference || '' %>">
            </div>
            <div class="field">
              <label for="delivery_status">Étape de livraison</label>
              <select id="delivery_status" name="delivery_status">
                <option value="">— inchangée —</option>
                <% deliveryStatuses.forEach(function (s) { %>
                  <option value="<%= s.value %>" <%= o.delivery_status === s.value ? 'selected' : '' %>><%= s.label %></option>
                <% }); %>
              </select>
            </div>
            <div class="field span-2">
              <label for="delivery-note">Note d’étape</label>
              <input id="delivery-note" name="note" type="text" maxlength="300" placeholder="Ex. : remis au livreur Kouassi">
            </div>
            <div class="field" style="align-self:end">
              <button class="btn btn--block" type="submit"><%- icon('truck', 'sm') %> Enregistrer</button>
            </div>
          </form>

          <details style="margin-bottom:var(--space-4)">
            <summary style="cursor:pointer;font-weight:600;color:var(--brand)">Ajouter une étape de suivi personnalisée</summary>
            <form method="post" action="/admin/commandes/<%= o.id %>/etapes" class="form-grid" style="margin-top:var(--space-3)">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="ev-label">Intitulé <span class="required-mark" aria-hidden="true">*</span></label>
                <input id="ev-label" name="label" type="text" required maxlength="160" placeholder="Ex. : Colis arrivé à Daoukro">
              </div>
              <div class="field">
                <label for="ev-detail">Précision</label>
                <input id="ev-detail" name="detail" type="text" maxlength="300">
              </div>
              <div class="field">
                <label for="ev-location">Lieu</label>
                <input id="ev-location" name="location" type="text" maxlength="160" placeholder="Daoukro">
              </div>
              <div class="field">
                <label for="ev-at">Date et heure</label>
                <input id="ev-at" name="happened_at" type="datetime-local" value="<%= dates.toDateTimeInput(dates.nowIso()) %>">
              </div>
              <div class="span-2">
                <label class="checkbox">
                  <input type="checkbox" name="public" value="1" checked>
                  <span>Visible par le client sur son suivi</span>
                </label>
                <button class="btn btn--ghost" type="submit"><%- icon('plus', 'sm') %> Ajouter l’étape</button>
              </div>
            </form>
          </details>
        <% } %>

        <% if (o.deliveryEvents.length) { %>
          <h3 style="font-size:.95rem">Étapes enregistrées</h3>
          <ol class="timeline">
            <% o.deliveryEvents.forEach(function (ev) { %>
              <li data-state="done">
                <span class="t-title"><%= ev.label %><% if (!ev.public) { %> <span class="pill">interne</span><% } %></span>
                <% if (ev.detail || ev.location) { %><span class="t-detail" style="display:block"><%= ev.detail %><%= ev.location ? ' — ' + ev.location : '' %></span><% } %>
                <span class="t-date"><%= dates.formatDateTime(ev.happened_at) %></span>
              </li>
            <% }); %>
          </ol>
        <% } %>

        <% if (o.trackingUrl) { %>
          <p><a class="btn btn--sm btn--ghost" href="<%= o.trackingUrl %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link', 'sm') %> Suivi transporteur</a></p>
        <% } %>
      </div>
    </div>

    <!-- ---------------- Devis ---------------- -->
    <% if (o.quote_required) { %>
      <div class="panel" id="devis">
        <div class="panel-head"><h2>Devis de livraison</h2><span class="hint">Aucun tarif inventé : le montant est fixé ici</span></div>
        <div class="panel-body">
          <dl class="kv" style="margin-bottom:var(--space-4)">
            <dt>État du devis</dt>
            <dd>
              <span class="pill pill--<%= o.quote_status === 'accepted' ? 'success' : (o.quote_status === 'refused' ? 'danger' : 'warn') %>">
                <%= ({ none: 'Non établi', requested: 'À établir', sent: 'Envoyé au client', accepted: 'Accepté', refused: 'Refusé' })[o.quote_status] || o.quote_status %>
              </span>
            </dd>
            <% if (o.quote_amount != null) { %><dt>Montant proposé</dt><dd><strong><%= money.format(o.quote_amount) %></strong></dd><% } %>
            <% if (o.quote_sent_at) { %><dt>Envoyé le</dt><dd><%= dates.formatDateTime(o.quote_sent_at) %></dd><% } %>
            <% if (o.quote_accepted_at) { %><dt>Accepté le</dt><dd><%= dates.formatDateTime(o.quote_accepted_at) %></dd><% } %>
          </dl>

          <% if (can('orders.write')) { %>
            <% if (o.quote_status !== 'accepted') { %>
              <form method="post" action="/admin/commandes/<%= o.id %>/devis" class="inline-form" style="margin-bottom:var(--space-3)">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="envoyer">
                <div class="field" style="flex:1 1 160px">
                  <label for="quote-amount">Frais de livraison (FCFA) <span class="required-mark" aria-hidden="true">*</span></label>
                  <input id="quote-amount" name="amount" type="number" min="0" step="1" inputmode="numeric" required
                         value="<%= o.quote_amount != null ? money.plain(o.quote_amount) : '' %>" placeholder="2500">
                </div>
                <div class="field" style="flex:2 1 240px">
                  <label for="quote-note">Message au client</label>
                  <input id="quote-note" name="note" type="text" maxlength="300" placeholder="Ex. : livraison par taxi-brousse, paiement à l’arrivée">
                </div>
                <button class="btn" type="submit"><%- icon('truck', 'sm') %> Envoyer le devis</button>
              </form>
              <p class="tiny muted">
                Le client reçoit le montant sur sa page de suivi et doit l’accepter avant de payer.
                Tant que le devis n’est pas accepté, la commande reste sans frais de livraison définitifs.
              </p>
              <form method="post" action="/admin/commandes/<%= o.id %>/devis" class="inline-form" style="margin-top:var(--space-3)">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="action" value="accepter">
                <button class="btn btn--ghost btn--sm" type="submit"
                        data-confirm-action="Confirmer que le client a accepté le devis de <%= money.format(o.quote_amount || 0) %> ?">
                  <%- icon('check', 'sm') %> Le client a accepté par téléphone
                </button>
              </form>
            <% } else { %>
              <div class="alert alert--success"><%- icon('check-circle', 'md') %><span>Devis accepté : les frais sont inclus dans le total de la commande.</span></div>
            <% } %>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- ---------------- Retours et remboursements ---------------- -->
    <div class="panel" id="retours">
      <div class="panel-head"><h2>Retours et remboursements</h2><span class="hint">Montants distincts des ventes</span></div>
      <div class="panel-body">
        <% if (o.refunds.length) { %>
          <div class="table-wrap" style="margin-bottom:var(--space-4)">
            <table class="data compact">
              <caption class="visually-hidden">Remboursements</caption>
              <thead><tr><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Motif</th><th scope="col" class="num">Montant</th><th scope="col">Statut</th><th scope="col" class="right">Action</th></tr></thead>
              <tbody>
                <% o.refunds.forEach(function (r) { %>
                  <tr>
                    <td class="tiny"><%= dates.formatDateTime(r.created_at) %></td>
                    <td class="tiny"><%= r.kind %></td>
                    <td class="tiny"><%= r.reason || '—' %></td>
                    <td class="num"><%= money.format(r.amount) %></td>
                    <td><span class="pill pill--<%= r.status === 'done' ? 'success' : 'warn' %>"><%= r.status %></span></td>
                    <td class="right">
                      <% if (r.status !== 'done' && can('orders.refund')) { %>
                        <form method="post" action="/admin/remboursements/<%= r.id %>/appliquer" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="order_id" value="<%= o.id %>">
                          <button class="btn btn--sm" type="submit" data-confirm-action="Appliquer ce remboursement de <%= money.format(r.amount) %> ?">Appliquer</button>
                        </form>
                      <% } else { %>
                        <span class="tiny muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (can('orders.refund')) { %>
          <% if (refundable > 0) { %>
            <form method="post" action="/admin/commandes/<%= o.id %>/remboursement">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-grid form-grid--3">
                <div class="field">
                  <label for="rf-kind">Type</label>
                  <select id="rf-kind" name="kind">
                    <option value="return">Retour de marchandise</option>
                    <option value="refund">Remboursement simple</option>
                    <option value="cancellation">Annulation</option>
                    <option value="exchange">Échange</option>
                  </select>
                </div>
                <div class="field">
                  <label for="rf-amount">Montant (FCFA) <span class="required-mark" aria-hidden="true">*</span></label>
                  <input id="rf-amount" name="amount" type="number" min="1" max="<%= refundable %>" step="1" inputmode="numeric" required value="<%= refundable %>">
                  <span class="field-help">Maximum remboursable : <%= money.format(refundable) %>.</span>
                </div>
                <div class="field">
                  <label for="rf-method">Moyen de remboursement</label>
                  <input id="rf-method" name="method" type="text" maxlength="120" placeholder="Espèces, Mobile Money…">
                </div>
                <div class="field span-2">
                  <label for="rf-reason">Motif</label>
                  <input id="rf-reason" name="reason" type="text" maxlength="300">
                </div>
              </div>

              <fieldset>
                <legend>Articles concernés (facultatif)</legend>
                <% o.items.forEach(function (it) { %>
                  <label class="checkbox">
                    <input type="checkbox" name="lignes" value="<%= it.id %>:1">
                    <span><%= it.name %> — <%= money.format(it.unit_price) %> × <%= it.qty %></span>
                  </label>
                <% }); %>
              </fieldset>

              <label class="checkbox">
                <input type="checkbox" name="restock" value="1">
                <span>Remettre les articles en stock (retour physique constaté)</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" name="appliquer" value="1">
                <span>Appliquer immédiatement (sinon le remboursement reste « en attente » et devra être validé)</span>
              </label>

              <button class="btn btn--danger" type="submit" data-confirm-action="Enregistrer ce remboursement ?"><%- icon('refresh', 'sm') %> Enregistrer le remboursement</button>
            </form>
          <% } else { %>
            <p class="tiny muted" style="margin:0">
              Aucun montant remboursable : la commande n’a pas encore été encaissée
              (<%= money.format(paidAmount) %> reçu, <%= money.format(o.amount_refunded) %> déjà remboursé).
            </p>
          <% } %>
        <% } else { %>
          <p class="tiny muted" style="margin:0">Votre rôle ne permet pas de créer un remboursement.</p>
        <% } %>
      </div>
    </div>

    <!-- ---------------- Historique ---------------- -->
    <div class="panel">
      <div class="panel-head"><h2>Historique</h2><span class="hint">Journal complet, y compris les événements internes</span></div>
      <div class="panel-body panel-body--flush">
        <ol class="timeline" style="padding:var(--space-4) var(--space-4) 0 42px">
          <% o.events.forEach(function (ev) { %>
            <li data-state="done">
              <span class="t-title"><%= scopeLabels[ev.scope] || ev.scope %> — <%= ev.message %></span>
              <% if (ev.from_value || ev.to_value) { %>
                <span class="t-detail" style="display:block"><%= ev.from_value || '—' %> → <%= ev.to_value || '—' %></span>
              <% } %>
              <span class="t-date">
                <%= dates.formatDateTime(ev.created_at) %>
                <% if (ev.actor_name) { %> · <%= ev.actor_name %><% } %>
                <% if (!ev.public) { %> · <span class="pill">interne</span><% } %>
              </span>
            </li>
          <% }); %>
        </ol>
        <% if (webhookEvents.length) { %>
          <div style="padding:var(--space-4)">
            <h3 style="font-size:.95rem">Notifications de paiement reçues</h3>
            <div class="table-wrap">
              <table class="data compact">
                <caption class="visually-hidden">Notifications du prestataire</caption>
                <thead><tr><th scope="col">Reçue le</th><th scope="col">Prestataire</th><th scope="col">Événement</th><th scope="col">Signature</th><th scope="col">Résultat</th></tr></thead>
                <tbody>
                  <% webhookEvents.forEach(function (ev) { %>
                    <tr>
                      <td class="tiny"><%= dates.formatDateTime(ev.received_at) %></td>
                      <td class="tiny mono"><%= ev.provider %></td>
                      <td class="tiny mono"><%= ev.event_id %></td>
                      <td><span class="pill pill--<%= ev.signature_ok ? 'success' : 'danger' %>"><%= ev.signature_ok ? 'valide' : 'refusée' %></span></td>
                      <td><span class="pill pill--<%= ev.status === 'processed' ? 'success' : (ev.status === 'duplicate' ? 'info' : 'warn') %>"><%= ev.status %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- =============== Colonne latérale =============== -->
  <div>
    <div class="panel" id="paiement">
      <div class="panel-head"><h2>Paiement</h2><span class="hint"><%= o.paymentMethod ? o.paymentMethod.name : o.payment_method_code %></span></div>
      <div class="panel-body">
        <dl class="kv" style="margin-bottom:var(--space-4)">
          <dt>Total</dt><dd><strong><%= money.format(o.total) %></strong></dd>
          <dt>Reçu</dt><dd><%= money.format(paidAmount) %></dd>
          <% if (o.amount_refunded) { %><dt>Remboursé</dt><dd><%= money.format(o.amount_refunded) %></dd><% } %>
          <% if (remaining > 0) { %><dt>Reste dû</dt><dd><strong style="color:var(--warn)"><%= money.format(remaining) %></strong></dd><% } %>
          <% if (o.paid_at) { %><dt>Encaissé le</dt><dd><%= dates.formatDateTime(o.paid_at) %></dd><% } %>
          <dt>Devise</dt><dd><%= o.currency %></dd>
        </dl>

        <% if (awaitingCash) { %>
          <% if (canConfirmCash) { %>
            <div class="alert alert--warn">
              <%- icon('cash', 'md') %>
              <div>
                <strong>Encaissement à confirmer</strong>
                <p style="margin:4px 0 0">Ne confirmez que si vous avez réellement reçu l’argent. La confirmation est
                horodatée et attribuée à votre compte.</p>
              </div>
            </div>
            <form method="post" action="/admin/commandes/<%= o.id %>/encaisser">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="cash-amount">Montant reçu (FCFA)</label>
                <input id="cash-amount" name="amount" type="number" min="0" step="1" inputmode="numeric" value="<%= money.plain(o.total) %>"
                       aria-describedby="cash-help">
                <span id="cash-help" class="field-help">Laissez le total proposé si le montant est exact.</span>
              </div>
              <div class="field">
                <label for="cash-note">Note (facultatif)</label>
                <input id="cash-note" name="note" type="text" maxlength="300" placeholder="Ex. : remis en main propre, reçu n°…">
              </div>
              <button class="btn btn--block" type="submit" data-confirm-action="Confirmer la réception de <%= money.format(o.total) %> ?"><%- icon('check', 'sm') %> Confirmer l’encaissement</button>
            </form>
            <form method="post" action="/admin/commandes/<%= o.id %>/encaissement-refuser" style="margin-top:var(--space-2)">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="reject-reason">Motif du refus</label>
                <input id="reject-reason" name="reason" type="text" maxlength="200" placeholder="Ex. : montant non reçu">
              </div>
              <button class="btn btn--ghost btn--sm btn--block" type="submit">Encaissement non reçu</button>
            </form>
          <% } else { %>
            <div class="alert alert--info">
              <%- icon('lock', 'md') %>
              <span>Votre rôle ne permet pas de confirmer un encaissement en espèces. Demandez à un utilisateur habilité.</span>
            </div>
          <% } %>
        <% } %>

        <% if (o.payments.length) { %>
          <details style="margin-top:var(--space-3)">
            <summary class="tiny muted" style="cursor:pointer">Tentatives de paiement (<%= o.payments.length %>)</summary>
            <ul class="tiny muted" style="padding-left:18px;margin:6px 0 0">
              <% o.payments.forEach(function (py) { %>
                <li>
                  <%= dates.formatDateTime(py.created_at) %> — <%= py.provider %> · <%= py.status %>
                  · <%= money.format(py.amount) %>
                  <% if (py.provider_reference) { %> · <span class="mono"><%= py.provider_reference %></span><% } %>
                  <% if (py.confirmed_by) { %> · confirmé par <%= py.confirmed_by %><% } %>
                </li>
              <% }); %>
            </ul>
          </details>
        <% } %>

        <div class="btn-row" style="margin-top:var(--space-4)">
          <form method="post" action="/admin/commandes/<%= o.id %>/relancer-paiement">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--sm btn--ghost" type="submit"><%- icon('refresh', 'sm') %> Nouvelle tentative de paiement</button>
          </form>
          <a class="btn btn--sm btn--quiet" href="/suivi/<%= o.tracking_token %>" target="_blank" rel="noopener"><%- icon('external-link', 'sm') %> Vue client</a>
        </div>

        <% if (can('orders.write') && !paid) { %>
          <form method="post" action="/admin/commandes/<%= o.id %>/relancer-paiement"
                style="margin-top:var(--space-4);border-top:1px solid var(--border);padding-top:var(--space-3)">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="method-change">Changer de moyen de paiement</label>
              <select id="method-change" name="payment_method">
                <% methods.forEach(function (m) { %>
                  <option value="<%= m.code %>" <%= o.payment_method_code === m.code ? 'selected' : '' %>><%= m.name %><%= m.enabled ? '' : ' (désactivé)' %></option>
                <% }); %>
              </select>
              <span class="field-help">Utile si le client change d’avis avant paiement. Le changement est journalisé.</span>
            </div>
            <button class="btn btn--sm btn--quiet" type="submit"><%- icon('refresh', 'sm') %> Appliquer et relancer</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Client</h2></div>
      <div class="panel-body">
        <dl class="kv">
          <dt>Nom</dt><dd><%= o.recipient_name %></dd>
          <dt>Téléphone</dt><dd><a href="tel:<%= String(o.recipient_phone).replace(/\D/g, '') %>"><%= formatPhone(o.recipient_phone) %></a></dd>
          <% if (o.recipient_email) { %><dt>E-mail</dt><dd><%= o.recipient_email %></dd><% } %>
          <dt>Compte</dt>
          <dd>
            <% if (o.customer_id && o.customer) { %>
              <a href="/admin/clients/<%= o.customer_id %>"><%= o.customer.full_name || 'Fiche client' %></a>
              <% if (o.customer.marketing_consent) { %><span class="pill pill--success" style="margin-left:4px">consentement pub.</span><% } %>
            <% } else { %>
              Commande sans compte
            <% } %>
          </dd>
          <dt>Consentement marketing</dt><dd><%= o.marketing_consent ? 'Donné' : 'Non donné' %></dd>
          <dt>Conditions acceptées</dt><dd><%= o.terms_accepted ? `Oui (${dates.formatDateTime(o.terms_accepted_at)})` : 'Non' %></dd>
        </dl>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h2>Note interne</h2><span class="hint">Jamais visible par le client</span></div>
      <div class="panel-body">
        <form method="post" action="/admin/commandes/<%= o.id %>/note">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="internal_note">Note</label>
            <textarea id="internal_note" name="internal_note" rows="4" maxlength="2000"><%= o.internal_note || '' %></textarea>
          </div>
          <button class="btn btn--sm btn--quiet" type="submit"><%- icon('check', 'sm') %> Enregistrer</button>
        </form>
      </div>
    </div>

    <% if (can('orders.cancel') && o.status !== 'cancelled') { %>
      <div class="panel" style="border-color:#f0c4c0">
        <div class="panel-head"><h2 style="color:var(--danger)">Annuler</h2></div>
        <div class="panel-body">
          <form method="post" action="/admin/commandes/<%= o.id %>/annuler" data-confirm="Annuler la commande <%= o.reference %> ?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="cancel-reason">Motif</label>
              <input id="cancel-reason" name="reason" type="text" maxlength="200" placeholder="Ex. : client injoignable">
            </div>
            <label class="checkbox">
              <input type="checkbox" name="restock" value="1" checked>
              <span>Restituer le stock réservé</span>
            </label>
            <button class="btn btn--danger btn--sm btn--block" type="submit"><%- icon('alert', 'sm') %> Annuler la commande</button>
            <p class="tiny muted" style="margin-top:var(--space-2)">
              Si la commande a déjà été encaissée, créez un remboursement : l’annulation ne rembourse pas automatiquement.
            </p>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('/admin/partials/footer') %>
