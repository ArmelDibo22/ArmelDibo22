<%
/** Erreur générique (403, 409, 422, 500…) — fragment de corps. */
const inAdmin = typeof adminLayout !== 'undefined' && adminLayout;
// Noms préfixés : les variables du gabarit ne doivent jamais masquer un `local`
// homonyme (une déclaration `const` dans un bloc `with` provoque une erreur TDZ).
const errStatus = typeof status !== 'undefined' && status ? Number(status) : 500;
const errMessage = typeof message !== 'undefined' && message ? message : 'Une erreur est survenue.';
const errCode = typeof code !== 'undefined' ? code : null;
const titles = {
  400: 'Demande incomplète',
  403: 'Accès refusé',
  404: 'Page introuvable',
  409: 'Action impossible en l’état',
  413: 'Fichier trop volumineux',
  415: 'Format de fichier non accepté',
  422: 'Données refusées',
  429: 'Trop de demandes',
  500: 'Erreur interne',
  503: 'Service momentanément indisponible',
};
%>
<div class="container" style="padding:var(--space-7) var(--space-4)">
  <div class="state state--error" style="max-width:620px;margin:0 auto">
    <%- icon('alert', 'xl') %>
    <p class="eyebrow">Erreur <%= errStatus %></p>
    <h1><%= titles[errStatus] || 'Une erreur est survenue' %></h1>
    <p><%= errMessage %></p>
    <% if (errCode) { %><p class="mono tiny muted">Code : <%= errCode %></p><% } %>
    <div class="btn-row" style="justify-content:center">
      <% if (errStatus >= 500) { %>
        <a class="btn" href="javascript:location.reload()">Réessayer</a>
      <% } else { %>
        <a class="btn" href="javascript:history.back()"><%- icon('arrow-left', 'sm') %> Retour</a>
      <% } %>
      <% if (inAdmin) { %>
        <a class="btn btn--ghost" href="/admin">Tableau de bord</a>
      <% } else { %>
        <a class="btn btn--ghost" href="/catalogue">Catalogue</a>
        <a class="btn btn--ghost" href="/panier">Mon panier</a>
      <% } %>
    </div>
    <% if (errStatus >= 500) { %>
      <p class="tiny muted" style="margin-top:var(--space-5)">
        L’incident a été journalisé. Si le problème persiste, prévenez la boutique :
        <% if (store.phoneDisplay) { %><a href="tel:<%= store.phoneRaw %>"><%= store.phoneDisplay %></a>.<% } else { %><a href="/contact">formulaire de contact</a>.<% } %>
      </p>
    <% } %>
    <% if (errStatus === 409) { %>
      <p class="tiny muted" style="margin-top:var(--space-5)">
        Ce message apparaît généralement quand le stock a changé entre-temps, ou quand la commande
        a déjà été traitée. Rechargez la page pour voir la situation actuelle.
      </p>
    <% } %>
  </div>
</div>
